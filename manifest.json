{
  "manifest_version": 3,
  "name": "ddd – de.wiktionary",
  "version": "1.0.0",
  "description": "Omnibox-Suche: ddd <wort> öffnet den Eintrag auf dem deutschen Wiktionary.",
  "omnibox": {
    "keyword": "ddd"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ddd – tippe ddd <wort> in die Adresszeile",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
